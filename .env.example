# Supabase project (Project Settings -> API). Without these, the Academy runs in demo mode
# and saves accounts and progress in the browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public address, used for canonical URLs, previews, the sitemap and certificate verification links.
VITE_SITE_URL=

# Google Search Console "HTML tag" verification code (the content value only).
VITE_GOOGLE_SITE_VERIFICATION=
